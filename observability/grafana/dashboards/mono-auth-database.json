{
	"id": null,
	"uid": "mono-auth-database",
	"title": "Mono Auth Database",
	"tags": ["mono-auth", "database"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "15s",
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "job",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": "label_values(up{app=\"mono-auth\"}, job)",
				"current": {
					"selected": true,
					"text": "mono-auth-app",
					"value": "mono-auth-app"
				},
				"includeAll": false,
				"multi": false,
				"refresh": 1
			}
		]
	},
	"panels": [
		{
			"type": "stat",
			"title": "DB Query Rate (qps)",
			"gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "sum(rate(db_queries_total{job=\"$job\"}[5m]))",
					"refId": "A"
				}
			],
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"], "values": false }
			}
		},
		{
			"type": "stat",
			"title": "DB p95 Latency (ms)",
			"gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(db_query_duration_seconds_bucket{job=\"$job\"}[5m])))",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"], "values": false }
			}
		},
		{
			"type": "stat",
			"title": "DB In-Flight Queries",
			"gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{ "expr": "max(db_in_flight_queries{job=\"$job\"})", "refId": "A" }
			],
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"], "values": false }
			}
		},
		{
			"type": "stat",
			"title": "Pool Connections Active / Max",
			"gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "max(db_pool_connections_active{job=\"$job\"}) / clamp_min(max(db_pool_connections_max{job=\"$job\"}), 1)",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"], "values": false }
			}
		},
		{
			"type": "timeseries",
			"title": "DB Queries by Operation and Table",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "sum by (op, table) (rate(db_queries_total{job=\"$job\"}[5m]))",
					"legendFormat": "{{op}}/{{table}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "DB Latency p50/p95/p99",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(db_query_duration_seconds_bucket{job=\"$job\"}[5m])))",
					"legendFormat": "p50",
					"refId": "A"
				},
				{
					"expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(db_query_duration_seconds_bucket{job=\"$job\"}[5m])))",
					"legendFormat": "p95",
					"refId": "B"
				},
				{
					"expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(db_query_duration_seconds_bucket{job=\"$job\"}[5m])))",
					"legendFormat": "p99",
					"refId": "C"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Cache Hit Ratio",
			"gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"expr": "(sum(rate(cache_ops_total{job=\"$job\",op=\"get\",result=\"hit\"}[5m])) or vector(0)) / clamp_min((sum(rate(cache_ops_total{job=\"$job\",op=\"get\"}[5m])) or vector(0)), 0.001)",
					"legendFormat": "hit_ratio",
					"refId": "A"
				}
			],
			"fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
		}
	]
}
