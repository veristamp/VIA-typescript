{
  "name": "via-v2",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun",
    "compile": "bun build src/main.ts --compile --outfile via-v2",
    "proto:generate": "protoc -I proto --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --plugin=protoc-gen-connect-es=./node_modules/.bin/protoc-gen-connect-es --es_out src/gen --es_opt target=ts --connect-es_out src/gen --connect-es_opt target=ts proto/via/tier2/v1/tier2.proto",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@qdrant/js-client-rest": "latest",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "hono": "latest",
    "json5": "latest",
    "jsonl": "latest",
    "pg": "latest",
    "winston": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "bun-types": "latest",
    "typescript": "latest"
  },
  "private": true
}
