// Mono-Auth Alloy Configuration
// OTLP -> Tempo/Loki/Prometheus forwarding + Docker Log Scraping

// ============================================================================
// SOURCES - Receive telemetry data
// ============================================================================

// 1. OTLP Receiver (from Application SDK)
otelcol.receiver.otlp "app" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  
  output {
    traces  = [otelcol.processor.batch.app.input]
    metrics = [otelcol.processor.batch.app.input]
    logs    = [otelcol.processor.batch.app.input]
  }
}

// 2. Docker Logs (Direct container stdout/stderr)
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/mono-auth-app"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  
  rule {
    target_label = "app"
    replacement  = "mono-auth"
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  forward_to = [loki.write.app.receiver]
}

// ============================================================================
// PROCESSORS - Batch and buffer data
// ============================================================================

otelcol.processor.batch "app" {
  timeout = "5s"
  
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.app.input]
    logs    = [otelcol.exporter.loki.app.input]
  }
}

// ============================================================================
// EXPORTERS - Send data to backends
// ============================================================================

// Tempo traces via OTLP (gRPC)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "mono-auth-tempo:4317"
    tls {
      insecure = true
    }
  }
}

// Prometheus metrics via Remote Write
otelcol.exporter.prometheus "app" {
  forward_to = [prometheus.remote_write.app.receiver]
}

prometheus.remote_write "app" {
  endpoint {
    url = "http://mono-auth-prometheus:9090/api/v1/write"
  }
}

// Loki logs  
otelcol.exporter.loki "app" {
  forward_to = [loki.relabel.otel_logs.receiver]
}

loki.relabel "otel_logs" {
  forward_to = [loki.write.app.receiver]
  rule {
    target_label = "app"
    replacement  = "mono-auth"
  }
}

loki.write "app" {
  endpoint {
    url = "http://mono-auth-loki:3100/loki/api/v1/push"
  }
}
